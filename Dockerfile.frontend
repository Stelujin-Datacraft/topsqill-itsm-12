# Dev/Prod frontend image for docker-compose (port 8080).
# Build args inject Vite public env at build time — never bake service-role secrets.
FROM node:22-alpine AS builder
WORKDIR /app

COPY package*.json ./
COPY .npmrc ./
# legacy-peer-deps via .npmrc — keeps React 18 installs reliable in Docker
RUN npm ci

COPY . .

ARG VITE_API_URL=/api
ARG VITE_USE_BACKEND_API=true
ARG VITE_SUPABASE_URL=
ARG VITE_SUPABASE_PUBLISHABLE_KEY=

ENV VITE_API_URL=$VITE_API_URL \
    VITE_USE_BACKEND_API=$VITE_USE_BACKEND_API \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY

RUN npm run build

FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
# Same-origin /api → Nest backend (required on GCP VMs; Vite env is build-time only).
RUN printf '%s\n' \
  'server {' \
  '  listen 8080;' \
  '  server_name _;' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  location /api/ {' \
  '    proxy_pass http://backend:3001/api/;' \
  '    proxy_http_version 1.1;' \
  '    proxy_set_header Host $host;' \
  '    proxy_set_header X-Real-IP $remote_addr;' \
  '    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
  '    proxy_set_header X-Forwarded-Proto $scheme;' \
  '    proxy_set_header Authorization $http_authorization;' \
  '    proxy_pass_header Authorization;' \
  '  }' \
  '  location / {' \
  '    try_files $uri $uri/ /index.html;' \
  '  }' \
  '}' > /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
