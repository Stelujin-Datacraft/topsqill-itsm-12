# VIS environment configuration (example — no real secrets)

# Required for Prisma persistence (set password via your secret manager / local env)
VIS_DATABASE_URL=postgresql://vis:CHANGE_ME@127.0.0.1:5432/vis_platform
VIS_MOCK_PG_BASE=postgresql://vis:CHANGE_ME@127.0.0.1:5432
VIS_PERSISTENCE=prisma
VIS_SECRET_PROVIDER=local
VIS_SECRET_MASTER_KEY=CHANGE_ME

# Pilot safety — must be DEV|TEST|UAT (PROD refused)
VIS_PILOT_ENV=TEST
VIS_PILOT_RECORD_PREFIX=VIS-PILOT-

# TopSqill Form API (never commit real keys)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=<anon JWT — role claim must be anon>
# SUPABASE_SERVICE_ROLE_KEY=<service_role JWT — role claim must be service_role>
# VIS_PILOT_TOPSQILL_ORG_ID=
# VIS_PILOT_TOPSQILL_FORM_ID=
# VIS_PILOT_TOPSQILL_FORM_NAME=VIS Integration Test Form

# ITAM Form Sync → Existing Application Form API (TopSqill edge function)
# NOTE: paths are /forms under form-api — NOT Nest /api/forms (404).
# ITAM_SYNC_REAL=1
# ITAM_SYNC_BASE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/form-api
# ITAM_SYNC_CREDENTIAL_REF=itam-sync-form-api-bearer
# ITAM_SYNC_FORM_ID=<ITAM Asset form UUID — create in TEST/UAT first>
# ITAM_SYNC_ORG_ID=<organization UUID>
# ITAM_SYNC_FORMS_PATH=/forms
# ITAM_SYNC_FORM_FIELDS_PATH=/forms/{formId}/fields
# ITAM_SYNC_RECORDS_PATH=/forms/{formId}/records
# ITAM_SYNC_RECORD_BY_ID_PATH=/forms/{formId}/records/{recordId}
# ITAM_SYNC_BOOTSTRAP_ANON_GATEWAY=1   # lab only: map SUPABASE_ANON_KEY into SecretProvider ref
# ITAM_SYNC_ALLOW_NON_ITAM_WRITE=1     # never set in prod; refuses non-ITAM forms by default
# ITAM_SYNC_ASSET_EXTERNAL_ID=<safe discovery asset id>

# Third-party sandbox (generic REST — not hardcoded to a vendor)
# VIS_PILOT_SOURCE_PROVIDER=generic-rest
# VIS_PILOT_SOURCE_BASE_URL=https://sandbox.example.com
# VIS_PILOT_SOURCE_API_VERSION=v1
# VIS_PILOT_SOURCE_AUTH_TYPE=API_KEY   # NONE|API_KEY|BEARER|BASIC|OAUTH2
# VIS_PILOT_SOURCE_CREDENTIAL_REF=pilot-source- cred
# VIS_PILOT_SOURCE_OPENAPI_URL=https://sandbox.example.com/openapi.json
# VIS_PILOT_SOURCE_RATE_LIMIT=60
# VIS_PILOT_SOURCE_TIMEOUT_MS=15000

# Redis (multi-process HA)
# REDIS_URL=redis://127.0.0.1:6379

# Optional real OIDC IdP (dev/test only)
# VIS_OIDC_ISSUER=https://idp.example.com
# VIS_OIDC_CLIENT_ID=
# VIS_OIDC_CLIENT_SECRET_REF=oidc-client-secret
# VIS_OIDC_REDIRECT_URI=http://127.0.0.1/callback

# Vault (optional)
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=
