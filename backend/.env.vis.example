# VIS environment configuration (example — no real secrets)
#
# VIS persistence now uses the shared Supabase project (same as the rest of the app).
# Do NOT set VIS_DATABASE_URL for normal Nest boot — that separate Prisma DB is obsolete.

# Durable VIS mode (default in production when SUPABASE_* are set)
# VIS_PERSISTENCE=supabase
# Legacy alias still accepted and routed to Supabase:
# VIS_PERSISTENCE=prisma

# Shared Supabase (server-only — never put service_role in VITE_*)
SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_DEV_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_KEY

VIS_SECRET_PROVIDER=local
VIS_SECRET_MASTER_KEY=CHANGE_ME

# Tests only — in-memory VisStore (forbidden in production without VIS_ALLOW_FILE_STORE=1)
# VIS_STORE_MEMORY=1
# VIS_PERSISTENCE=memory

# Optional PG mock apps for readiness-gate E2E (NOT used for VisStore SoR)
# VIS_MOCK_PG_BASE=postgresql://vis:CHANGE_ME@127.0.0.1:5432

# Apply reviewable SQL before first durable boot:
#   supabase/migrations/20261010090000_vis_supabase_persistence.sql
# (manual apply to Dev Supabase — agents must not auto-migrate)

# Pilot safety — must be DEV|TEST|UAT (PROD refused)
VIS_PILOT_ENV=TEST
VIS_PILOT_RECORD_PREFIX=VIS-PILOT-

# TopSqill Form API (never commit real keys)
# VIS_PILOT_TOPSQILL_ORG_ID=
# VIS_PILOT_TOPSQILL_FORM_ID=
# VIS_PILOT_TOPSQILL_FORM_NAME=VIS Integration Test Form

# Redis (multi-process HA)
# REDIS_URL=redis://127.0.0.1:6379

# Optional real OIDC IdP (dev/test only)
# VIS_OIDC_ISSUER=https://idp.example.com
# VIS_OIDC_CLIENT_ID=
# VIS_OIDC_CLIENT_SECRET_REF=oidc-client-secret
# VIS_OIDC_REDIRECT_URI=http://127.0.0.1/callback

# Vault (optional)
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=
