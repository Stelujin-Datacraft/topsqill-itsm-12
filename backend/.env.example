# Server
PORT=3001
NODE_ENV=development
# Deployment identity (preferred over NODE_ENV for feature gates).
# Use "development" for Dev deployments and "production" for Prod deployments.
# Dev and Prod share the same GitHub repository but are separate environments.
ENVIRONMENT=development
CORS_ORIGIN=http://localhost:8080
REQUEST_BODY_LIMIT=2mb

# Promotional Transfer (selective Dev → Prod promotion)
# Default: enabled when ENVIRONMENT=development; disabled when ENVIRONMENT=production.
# Explicit override: PROMOTIONAL_TRANSFER_ENABLED=true|false
PROMOTIONAL_TRANSFER_ENABLED=true
# PROMOTION_SOURCE_KEY=TopsqillITSM_Dev
# PROMOTION_TARGET_KEY=TopsqillITSM_Prod
# Optional dual-DB Prod target (never expose these to the frontend):
# PROMOTION_PROD_SUPABASE_URL=
# PROMOTION_PROD_SUPABASE_SERVICE_ROLE_KEY=
# PROMOTION_PROD_ORG_ID=
# PROMOTION_PROD_PROJECT_MAP={"dev-project-uuid":"prod-project-uuid"}

# Supabase / PostgreSQL
# Use the Development Supabase project locally; Production uses a separate project.
# Prefer SUPABASE_* (not VITE_*) for Nest. Never commit real keys.
SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_DEV_ANON_KEY
# Required server-only credential. Never place it in Vite / frontend env
# because VITE_* values are bundled into the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_KEY

# ITAM Network Discovery persistence (pg Pool → Supabase Postgres)
# NODE_ENV=production is fine for containers; ENVIRONMENT distinguishes Dev vs Prod.
# Both Dev and Prod require a connection string — memory mode is unit-tests only.
#
# ITAM_DISCOVERY_DATABASE_URL = Supabase Dashboard → Project Settings → Database
#   → Connection string (URI). Use the Dev project on Dev VMs and the Prod project
#   on Prod. Never put Prod credentials in the Dev environment (or the reverse).
# ITAM_DISCOVERY_DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# ITAM_DISCOVERY_PERSISTENCE=postgres
# Schema DDL at Nest boot is OFF by default for deployed envs. Apply manually:
#   supabase/migrations/20260930120000_itam_network_discovery.sql
#   supabase/migrations/20260930130000_itam_phases_b_d.sql
#   supabase/migrations/20260930140000_itam_form_sync.sql
# (plus existing core it_assets / asset_software). Do not auto-migrate Prod from Nest.
# ITAM_DISCOVERY_APPLY_SCHEMA=0
#
# Unit tests only (never set on Dev/Prod):
# ITAM_DISCOVERY_UNIT_TEST=1
# ITAM_DISCOVERY_PERSISTENCE=memory

# Workflow queue (async concurrent jobs)
WORKFLOW_QUEUE_BATCH_SIZE=20
WORKFLOW_QUEUE_CONCURRENCY=10
WORKFLOW_EXECUTOR_MODE=nestjs
WORKFLOW_REDIS_QUEUE=workflow-jobs

# Optional: Redis for distributed job queue (falls back to DB queue if unset)
# REDIS_URL=redis://localhost:6379

# Data feed execution: nestjs (native) or edge (legacy Deno)
DATA_FEED_EXECUTOR_MODE=nestjs

# Edge function timeout (legacy edge mode only)
EDGE_FUNCTION_TIMEOUT_MS=120000

# AI (optional)
LOVABLE_API_KEY=your-lovable-api-key
