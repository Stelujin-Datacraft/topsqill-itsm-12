# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080
REQUEST_BODY_LIMIT=2mb

# Supabase / PostgreSQL
# These two public values are also loaded automatically from the repository
# root .env (VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Required server-only credential. Never place it in the repository root Vite
# environment because VITE_* values are bundled into the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Workflow queue (async concurrent jobs)
WORKFLOW_QUEUE_BATCH_SIZE=20
WORKFLOW_QUEUE_CONCURRENCY=10
WORKFLOW_EXECUTOR_MODE=nestjs
WORKFLOW_REDIS_QUEUE=workflow-jobs

# Optional: Redis for distributed job queue (falls back to DB queue if unset)
# REDIS_URL=redis://localhost:6379

# Data feed execution: nestjs (native) or edge (legacy Deno)
DATA_FEED_EXECUTOR_MODE=nestjs

# Edge function timeout (legacy edge mode only)
EDGE_FUNCTION_TIMEOUT_MS=120000

# AI (optional)
LOVABLE_API_KEY=your-lovable-api-key
