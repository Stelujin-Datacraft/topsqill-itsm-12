// HISTORICAL column reference only. Runtime persistence is Supabase, not Prisma.
// Do not set VIS_DATABASE_URL. Apply:
//   supabase/migrations/20261010120000_vis_supabase_persistence.sql
// The datasource URL below is unused by the backend.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("VIS_DATABASE_URL")
}

model VisUserRef {
  id        String   @id @default(uuid())
  email     String?
  tenantId  String?  @map("tenant_id")
  orgId     String?  @map("organization_id")
  roles     Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId, orgId])
  @@map("vis_user_refs")
}

model VisCredentialReference {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  tenantId       String?   @map("tenant_id")
  name           String
  type           String
  /// Opaque handle — never plaintext secret in this table
  secretHandle   String    @map("secret_handle")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  connections VisConnection[]

  @@index([organizationId])
  @@map("vis_credential_references")
}

model VisConnection {
  id              String    @id @default(uuid())
  organizationId  String?   @map("organization_id")
  name            String
  kind            String
  environment     String    @default("DEV")
  baseUrl         String?   @map("base_url")
  authType        String    @map("auth_type")
  credentialRefId String?   @map("credential_ref_id")
  config          Json?
  allowPrivateNet Boolean   @default(false) @map("allow_private_network")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  credentialRef VisCredentialReference? @relation(fields: [credentialRefId], references: [id])

  @@index([organizationId])
  @@map("vis_connections")
}

model VisIntegration {
  id               String    @id @default(uuid())
  organizationId   String?   @map("organization_id")
  tenantId         String?   @map("tenant_id")
  name             String
  description      String?
  status           String    @default("DRAFT")
  environment      String    @default("DEV")
  promptText       String?   @map("prompt_text")
  currentVersionId String?   @map("current_version_id")
  createdBy        String?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  versions   VisIntegrationVersion[]
  executions VisExecution[]
  audits     VisAuditLog[]

  @@index([organizationId, status])
  @@index([tenantId])
  @@map("vis_integrations")
}

model VisIntegrationVersion {
  id            String   @id @default(uuid())
  integrationId String   @map("integration_id")
  version       Int
  status        String   @default("DRAFT")
  design        Json?
  directions    Json?
  aiProposal    Json?    @map("ai_proposal")
  userChanges   Json?    @map("user_changes")
  eventConfig   Json?    @map("event_config")
  sourceFields  Json?    @map("source_fields")
  sourceSample  Json?    @map("source_sample")
  openApiDiscovery Json? @map("openapi_discovery")
  selectedEndpoint Json? @map("selected_endpoint")
  finalConfiguration Json? @map("final_configuration")
  createdAt     DateTime @default(now()) @map("created_at")

  integration VisIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, version])
  @@map("vis_integration_versions")
}

model VisSchemaCache {
  id             String   @id @default(uuid())
  connectionId   String   @map("connection_id")
  applicationKey String?  @map("application_key")
  formId         String   @map("form_id")
  formName       String?  @map("form_name")
  fields         Json
  apiVersion     String?  @map("api_version")
  schemaVersion  String?  @map("schema_version")
  schemaHash     String?  @map("schema_hash")
  retrievedAt    DateTime @default(now()) @map("retrieved_at")

  @@unique([connectionId, formId])
  @@map("vis_schema_cache")
}

model VisExecution {
  id               String    @id @default(uuid())
  integrationId    String    @map("integration_id")
  versionId        String?   @map("version_id")
  status           String    @default("QUEUED")
  trigger          String?
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  recordsRead      Int       @default(0) @map("records_read")
  recordsCreated   Int       @default(0) @map("records_created")
  recordsUpdated   Int       @default(0) @map("records_updated")
  recordsFailed    Int       @default(0) @map("records_failed")
  retryCount       Int       @default(0) @map("retry_count")
  errorMessage     String?   @map("error_message")
  errorCode        String?   @map("error_code")
  correlationId    String?   @map("correlation_id")
  workers          Int?
  repairReportId   String?   @map("repair_report_id")
  payload          Json?
  createdAt        DateTime  @default(now()) @map("created_at")

  integration VisIntegration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  logs        VisExecutionLog[]

  @@index([integrationId, status])
  @@index([correlationId])
  @@map("vis_executions")
}

model VisExecutionLog {
  id            String   @id @default(uuid())
  executionId   String   @map("execution_id")
  integrationId String?  @map("integration_id")
  correlationId String?  @map("correlation_id")
  level         String
  step          String?
  message       String
  recordId      String?  @map("record_id")
  errorCode     String?  @map("error_code")
  metadata      Json?
  timestamp     DateTime @default(now())

  execution VisExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([correlationId])
  @@map("vis_execution_logs")
}

model VisAuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  integrationId  String?  @map("integration_id")
  versionId      String?  @map("version_id")
  actorId        String?  @map("actor_id")
  action         String
  detail         Json?
  createdAt      DateTime @default(now()) @map("created_at")

  integration VisIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([integrationId])
  @@index([action, createdAt])
  @@map("vis_audit_logs")
}

model VisDeadLetterItem {
  id            String   @id @default(uuid())
  integrationId String   @map("integration_id")
  executionId   String?  @map("execution_id")
  sourceRecord  Json     @map("source_record")
  error         String
  retryCount    Int      @default(0) @map("retry_count")
  status        String   @default("OPEN")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([integrationId])
  @@map("vis_dead_letter_items")
}

model VisEvent {
  id              String   @id @default(uuid())
  eventId         String   @unique @map("event_id")
  integrationId   String?  @map("integration_id")
  status          String
  eventType       String?  @map("event_type")
  entityId        String?  @map("entity_id")
  payload         Json?
  correlationId   String?  @map("correlation_id")
  traceId         String?  @map("trace_id")
  receivedAt      DateTime @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")
  metadata        Json?

  @@index([integrationId, status])
  @@index([entityId])
  @@map("vis_events")
}

model VisEventEndpoint {
  id            String   @id @default(uuid())
  integrationId String   @map("integration_id")
  path          String
  secretRef     String?  @map("secret_ref")
  config        Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([integrationId])
  @@map("vis_event_endpoints")
}

model VisEventSubscription {
  id            String   @id @default(uuid())
  integrationId String   @map("integration_id")
  config        Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([integrationId])
  @@map("vis_event_subscriptions")
}

model VisEventDeadLetter {
  id            String   @id @default(uuid())
  integrationId String?  @map("integration_id")
  eventId       String?  @map("event_id")
  payload       Json?
  error         String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([integrationId])
  @@map("vis_event_dead_letters")
}

model VisEventCheckpoint {
  id            String   @id @default(uuid())
  integrationId String   @map("integration_id")
  cursor        String?
  metadata      Json?
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([integrationId])
  @@map("vis_event_checkpoints")
}

// ── Phase 5–10 enterprise ────────────────────────────────────────────────

model VisCodegenArtifact {
  id              String   @id @default(uuid())
  integrationId   String   @map("integration_id")
  versionId       String?  @map("version_id")
  language        String
  files           Json
  validation      Json?
  securityScan    Json?    @map("security_scan")
  dependencyScan  Json?    @map("dependency_scan")
  status          String   @default("GENERATED")
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([integrationId])
  @@map("vis_codegen_artifacts")
}

model VisPromotion {
  id              String   @id @default(uuid())
  integrationId   String   @map("integration_id")
  fromEnvironment String   @map("from_environment")
  toEnvironment   String   @map("to_environment")
  versionId       String?  @map("version_id")
  versionNumber   Int?     @map("version_number")
  envConfig       Json?    @map("env_config")
  actorId         String?  @map("actor_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([integrationId])
  @@map("vis_promotions")
}

model VisChangeHistory {
  id            String   @id @default(uuid())
  integrationId String   @map("integration_id")
  versionId     String?  @map("version_id")
  action        String
  detail        Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([integrationId, createdAt])
  @@map("vis_change_history")
}

model VisApproval {
  id            String   @id @default(uuid())
  integrationId String   @map("integration_id")
  versionId     String?  @map("version_id")
  actorId       String?
  decision      String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([integrationId, versionId])
  @@map("vis_approvals")
}

model VisMetricSample {
  id         String   @id @default(uuid())
  name       String
  labels     Json?
  value      Float
  kind       String
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([name, recordedAt])
  @@map("vis_metric_samples")
}

model VisTraceSpan {
  id            String    @id @default(uuid())
  traceId       String    @map("trace_id")
  spanId        String    @map("span_id")
  parentSpanId  String?   @map("parent_span_id")
  name          String
  correlationId String?   @map("correlation_id")
  executionId   String?   @map("execution_id")
  eventId       String?   @map("event_id")
  attributes    Json?
  startedAt     DateTime  @map("started_at")
  endedAt       DateTime? @map("ended_at")

  @@index([traceId])
  @@index([spanId])
  @@map("vis_trace_spans")
}

model VisAlert {
  id        String   @id @default(uuid())
  ruleId    String   @map("rule_id")
  message   String
  severity  String
  value     Float?
  status    String   @default("OPEN")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("vis_alerts")
}

model VisReconciliationReport {
  id            String   @id @default(uuid())
  integrationId String   @map("integration_id")
  versionId     String?  @map("version_id")
  mode          String
  diffCount     Int      @map("diff_count")
  diffs         Json
  status        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([integrationId])
  @@map("vis_reconciliation_reports")
}

model VisRepairReport {
  id            String   @id @default(uuid())
  reportId      String   @map("report_id")
  integrationId String   @map("integration_id")
  versionId     String?  @map("version_id")
  actorId       String?  @map("actor_id")
  items         Json
  status        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([integrationId])
  @@map("vis_repair_reports")
}

model VisDriftFinding {
  id           String   @id @default(uuid())
  connectionId String?  @map("connection_id")
  formId       String?  @map("form_id")
  findings     Json
  maxSeverity  String?  @map("max_severity")
  acknowledged Boolean  @default(false)
  detectedAt   DateTime @default(now()) @map("detected_at")

  @@index([connectionId])
  @@map("vis_drift_findings")
}

model VisImpactAnalysis {
  id            String   @id @default(uuid())
  findingCount  Int      @map("finding_count")
  affectedCount Int      @map("affected_count")
  affected      Json
  aiProposals   Json?    @map("ai_proposals")
  requiresApproval Boolean @default(true) @map("requires_approval")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("vis_impact_analyses")
}

model VisConnector {
  id             String    @id @default(uuid())
  name           String
  vendor         String
  version        String
  category       String
  description    String?
  capabilities   Json
  authentication Json
  operations     Json
  visibility     String    @default("PRIVATE")
  lifecycle      String    @default("DRAFT")
  securityStatus String    @default("PENDING") @map("security_status")
  publisher      String?
  package        Json?
  certification  Json?
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@unique([name, vendor, version])
  @@index([lifecycle, visibility])
  @@map("vis_connectors")
}

model VisConnectorInstall {
  id             String   @id @default(uuid())
  connectorId    String   @map("connector_id")
  organizationId String   @map("organization_id")
  integrationId  String?  @map("integration_id")
  version        String
  status         String   @default("ENABLED")
  installedAt    DateTime @default(now()) @map("installed_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("vis_connector_installs")
}

model VisConnectorUpgrade {
  id               String    @id @default(uuid())
  installId        String    @map("install_id")
  fromConnectorId  String    @map("from_connector_id")
  toConnectorId    String    @map("to_connector_id")
  fromVersion      String    @map("from_version")
  toVersion        String    @map("to_version")
  status           String    @default("PENDING_APPROVAL")
  createdAt        DateTime  @default(now()) @map("created_at")
  appliedAt        DateTime? @map("applied_at")
  rolledBackAt     DateTime? @map("rolled_back_at")

  @@map("vis_connector_upgrades")
}

model VisAiRecommendation {
  id                     String   @id @default(uuid())
  type                   String
  reason                 String
  evidence               Json
  confidence             String
  affectedIntegrationId  String?  @map("affected_integration_id")
  affectedVersionId      String?  @map("affected_version_id")
  proposedChange         Json     @map("proposed_change")
  risk                   String
  status                 String   @default("PROPOSED")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@index([affectedIntegrationId, status])
  @@map("vis_ai_recommendations")
}

model VisGeneratedTestSuite {
  id            String   @id @default(uuid())
  integrationId String   @map("integration_id")
  tests         Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([integrationId])
  @@map("vis_generated_test_suites")
}

model VisGeneratedDoc {
  id            String   @id @default(uuid())
  integrationId String   @map("integration_id")
  markdown      String
  structured    Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([integrationId])
  @@map("vis_generated_docs")
}

model VisHealingAction {
  id            String   @id @default(uuid())
  actionType    String   @map("action_type")
  trigger       String
  integrationId String?  @map("integration_id")
  executionId   String?  @map("execution_id")
  versionId     String?  @map("version_id")
  status        String
  detail        String?
  evidence      Json?
  result        Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([integrationId, createdAt])
  @@index([actionType, status])
  @@map("vis_healing_actions")
}

model VisSecretBlob {
  id        String   @id @default(uuid())
  refId     String   @unique @map("ref_id")
  /// AES-GCM ciphertext (base64) — never plaintext
  ciphertext String
  provider  String   @default("local-encrypted")
  rotatedAt DateTime? @map("rotated_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vis_secret_blobs")
}

model VisPolicyRule {
  id          String   @id @default(uuid())
  ruleKey     String   @unique @map("rule_key")
  name        String
  description String?
  enabled     Boolean  @default(true)
  blocking    Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("vis_policy_rules")
}

/// Generic JSON document fallback for collections not yet fully normalized
model VisDocument {
  id         String   @id @default(uuid())
  collection String
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([collection])
  @@map("vis_documents")
}
