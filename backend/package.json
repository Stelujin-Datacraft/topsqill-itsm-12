{
  "name": "topsqill-backend",
  "version": "1.0.0",
  "description": "NestJS backend API for TopSqill platform",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "TSC_COMPILE_ON_ERROR=true nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:vis": "npx tsx test/vis/vis.phase1.test.ts && npx tsx test/vis/vis.phase2.test.ts && VIS_STORE_MEMORY=1 VIS_PERF_COUNT=2000 npx tsx test/vis/vis.phase3.test.ts && VIS_STORE_MEMORY=1 VIS_EVENT_LOAD=500 npx tsx test/vis/vis.phase4.test.ts && VIS_STORE_MEMORY=1 npx tsx test/vis/vis.phase5-10.test.ts",
    "test:vis:phase3": "VIS_STORE_MEMORY=1 VIS_PERF_COUNT=2000 npx tsx test/vis/vis.phase3.test.ts && VIS_STORE_MEMORY=1 VIS_EVENT_LOAD=500 npx tsx test/vis/vis.phase4.test.ts",
    "test:vis:perf100k": "VIS_STORE_MEMORY=1 VIS_PERF_COUNT=100000 npx tsx test/vis/vis.phase3.test.ts",
    "test:vis:phase4": "VIS_STORE_MEMORY=1 VIS_EVENT_LOAD=1000 npx tsx test/vis/vis.phase4.test.ts",
    "test:vis:hardening": "VIS_PERSISTENCE=prisma npx tsx test/vis/vis.hardening.test.ts",
    "test:vis:hardening:100k": "VIS_PERSISTENCE=prisma VIS_LOAD_100K=1 npx tsx test/vis/vis.hardening.test.ts",
    "test:vis:readiness": "VIS_PERSISTENCE=prisma npx tsx test/vis/vis.readiness-gate.test.ts",
    "test:vis:pilot": "VIS_PERSISTENCE=prisma VIS_PILOT_ENV=TEST npx tsx test/vis/vis.pilot-enablement.test.ts",
    "test:vis:secrets": "bash ../scripts/security/scan.sh",
    "test:itam:discovery": "npx tsx test/itam/itam.network-discovery.test.ts",
    "test:itam:discovery:persist": "ITAM_DISCOVERY_PERSISTENCE=postgres npx tsx test/itam/itam.discovery-persistence.test.ts",
    "test:itam:phases-bd": "npx tsx test/itam/itam.phases-b-d.test.ts",
    "test:itam:phases-bd:persist": "ITAM_DISCOVERY_PERSISTENCE=postgres npx tsx test/itam/itam.phases-b-d.test.ts",
    "test:itam:form-sync": "npx tsx test/itam/itam.form-sync.test.ts",
    "test:itam:form-sync:real": "ITAM_SYNC_REAL=1 npx tsx test/itam/itam.form-sync.test.ts",
    "test:itam:all": "npx tsx test/itam/itam.network-discovery.test.ts && npx tsx test/itam/itam.phases-b-d.test.ts && npx tsx test/itam/itam.form-sync.test.ts",
    "prisma:vis:generate": "prisma generate --schema=src/vis/prisma/schema.prisma",
    "prisma:vis:push": "prisma db push --schema=src/vis/prisma/schema.prisma",
    "security:scan": "bash ../scripts/security/scan.sh",
    "dr:drill": "bash ../scripts/dr/restore-drill.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "^2.52.0",
    "@types/pg": "^8.20.0",
    "basic-ftp": "^6.0.1",
    "bullmq": "^5.81.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "hono": "^4.12.32",
    "ioredis": "^5.11.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.22.0",
    "prisma": "5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.7.2"
  }
}
