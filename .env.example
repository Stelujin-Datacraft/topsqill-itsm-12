# Copy to .env on each VM. Never commit real keys.
# Dev VM = Development Supabase project. Prod VM = Production Supabase project.

ENVIRONMENT=development
# Prod VM must use: ENVIRONMENT=production

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Anon / publishable key (also used as VITE bake-in for the frontend image)
SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_KEY
# Server-only — never put this in VITE_*
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional. If unset, Nest still boots; ITAM Discovery APIs stay unavailable.
# ITAM_DISCOVERY_DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# VITE_API_URL=/api
# CORS_ORIGIN=http://YOUR_VM_IP:8080

# --- Promotional Transfer (Dev VM only) ---
# Leave unset / false on Prod VM.
# PROMOTIONAL_TRANSFER_ENABLED=true
# Dual-DB: Dev Nest writes selected config into Prod Supabase (service_role only on Dev .env).
# PROMOTION_PROD_SUPABASE_URL=https://YOUR_PROD_PROJECT.supabase.co
# PROMOTION_PROD_SUPABASE_SERVICE_ROLE_KEY=YOUR_PROD_SERVICE_ROLE_KEY
# PROMOTION_PROD_ORG_ID=YOUR_PROD_ORGANIZATION_UUID
# PROMOTION_PROD_PROJECT_MAP={"dev-project-uuid":"prod-project-uuid"}
