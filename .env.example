# =============================================================================
# TopSkill ITSM — environment template (PLACEHOLDERS ONLY)
# Copy to `.env` for local Development. Never commit real secrets.
#
# Development and Production MUST use different Supabase projects.
# =============================================================================

# --- Frontend (Vite / browser) — public client-side values ---
VITE_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
# Preferred name:
VITE_SUPABASE_ANON_KEY=YOUR_DEV_ANON_KEY
# Legacy alias still accepted by the frontend client:
# VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_DEV_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_DEV_PROJECT_REF

VITE_API_URL=http://localhost:3001/api
VITE_USE_BACKEND_API=true

# Optional app environment flags (Promotional Transfer, etc.)
VITE_ENVIRONMENT=development
VITE_PROMOTIONAL_TRANSFER_ENABLED=true

# --- Backend (NestJS) — server-only; never expose service_role to the browser ---
SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_DEV_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_KEY

PORT=3001
ENVIRONMENT=development
PROMOTIONAL_TRANSFER_ENABLED=true
CORS_ORIGIN=http://localhost:8080
